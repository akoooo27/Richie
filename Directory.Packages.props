<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Static code analysis -->
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.32.0.713" />
    
    <!-- Aspire -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.5.1" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.5.1" />
    <PackageVersion Include="Aspire.Hosting.EntityFrameworkCore" Version="13.5.1-preview.1.26420.4" />

    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.5.1" />

    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.9.0" />
    
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.GrpcNetClient" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    
    <!-- Domain -->
    <PackageVersion Include="ErrorOr" Version="2.1.1" />
    <PackageVersion Include="Vogen" Version="8.0.7" />
    <PackageVersion Include="Mediator.Abstractions" Version="3.0.2" />
    
    <!-- Infrastructure -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />

    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    
    <PackageVersion Include="Duende.IdentityServer" Version="8.0.6" />
    <PackageVersion Include="Duende.IdentityServer.EntityFramework" Version="8.0.6" />
    <PackageVersion Include="Duende.IdentityServer.AspNetIdentity" Version="8.0.6" />
    
    <!-- BFF -->
    <PackageVersion Include="Duende.BFF" Version="4.2.0" />
    <PackageVersion Include="Duende.BFF.EntityFramework" Version="4.2.0" />
    <PackageVersion Include="Duende.BFF.Yarp" Version="4.2.0" />
    
    <!-- Serilog -->
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>
</Project>