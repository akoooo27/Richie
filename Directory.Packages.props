<Project>
  
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- Static code analysis -->
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
    
    <!-- Aspire hosting -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.2" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.2" />
    <PackageVersion Include="Aspire.Hosting.EntityFrameworkCore" Version="13.6.2-preview.1.26519.11" />
    <PackageVersion Include="Aspire.Hosting.Azure.KeyVault" Version="13.6.2" />
    
    <!-- Domain -->
    <PackageVersion Include="Mediator.Abstractions" Version="3.0.2" />
    
    <!-- Infrastructure -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    
    <PackageVersion Include="Aspire.Npgsql" Version="13.6.2" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.2" />

    <PackageVersion Include="Duende.Storage.PostgreSql" Version="1.1.1" />
    
    <PackageVersion Include="Duende.IdentityServer" Version="8.0.10" />
    <PackageVersion Include="Duende.IdentityServer.EntityFramework" Version="8.0.10" />
    
    <PackageVersion Include="Duende.UserManagement" Version="1.0.0" />
    <PackageVersion Include="Duende.UserManagement.IdentityServer8" Version="1.0.0" />
    
    <!-- Aspire ServiceDefaults -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.20.1-beta.1" />

    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
  </ItemGroup>
  
</Project>
